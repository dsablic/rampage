  "arches": [
    {"name": "x86_64", "triple": "x86_64-linux-musl"},
    {"name": "aarch64", "triple": "aarch64-linux-musl"}
  ],
  "compilers": [
    {"name": "zig", "description": "zig cc (Zig's bundled clang/LLVM); compiles and links"},
    {"name": "clang", "description": "Homebrew clang against Zig's musl headers; zig cc links"}
  ],
  "optimizations": ["O0", "O2", "Os"],
  "link": "zig cc -static -g (zig strips symbols at -Os otherwise) against Zig's musl for the triple, same -O flag; no section garbage collection",
  "strip": "rampage-eval strip (stripped) and rampage-eval strip --keep-symbols (twin) of the same linked image",
  "split": {
    "rule": "version",
    "unit": "library version: every training binary links a target library's training version, every held-out binary one of its held-out versions; negatives link no target library",
    "fast_programs_per_library": 1,
    "max_heldout_overlap": 0.5,
    "final": "target-library versions neither training nor held-out holds, built from source with the same matrix (Alpine's gcc builds train and are held out); read only by `flywheel-eval --split final --final-reason TEXT`, which records every read"
  }
}
